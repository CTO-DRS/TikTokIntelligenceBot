# ============================================================
# TikTok Intelligence Bot — environment template
# Copy to docker/.env and fill in the secrets.  NEVER commit the real file.
# ============================================================

# --- Telegram (from @BotFather) ---
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# comma separated numeric telegram ids (from @userinfobot) → SUPER_ADMIN
ADMIN_USER_IDS=111111111,222222222

# --- Database (service name 'postgres' inside docker network) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=tiktok
POSTGRES_PASSWORD=change_me_strong
POSTGRES_DB=tiktok_intel

# --- Redis (service name 'redis' inside docker network) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- Security ---
# generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

# --- TikTok collector (optional cookie improves stability; proxy optional) ---
TIKTOK_SESSIONID=
SCRAPING_PROXY=
DEMO_FALLBACK=true

# --- Webhook (leave empty for polling) ---
WEBHOOK_URL=
WEBHOOK_PORT=8080
WEBHOOK_SECRET=tg-webhook-secret

# --- Monitoring ---
SENTRY_DSN=
METRICS_ENABLED=true
METRICS_PORT=9091
LOG_LEVEL=INFO

# --- Defaults ---
DEFAULT_LANGUAGE=ar
